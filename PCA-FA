  barplot(v,horiz=TRUE,names.arg=gsub("_"," ",names(v)),las=1,
          cex.names=.66,col="#2166AC",xlab="Contribution (%)",main=ttl)
  abline(v=100/nrow(rotation),lty=2,col="red")
}
