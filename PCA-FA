paired <- function(name, title, left, right, w=15, h=7.5) {
  plot_both(name, function() {
    old <- par(no.readonly=TRUE)
    on.exit(par(old))
    par(mfrow=c(1,2), oma=c(0,0,3.4,0))
    left()
    right()
    mtext(title, side=3, outer=TRUE, line=1.0, cex=1.35, font=2)
  }, w=w, h=h)
}
# Graphing:
scree_panel <- function(v, ttl, line1=FALSE) {
  par(mar=c(5,5,3,1))
  plot(seq_len(nrow(v)),v$Eigenvalue,type="b",pch=19,cex=.65,
       xlab="Principal component",ylab="Eigenvalue",main=ttl)
  if(line1) abline(h=1,lty=2,col="red")}
cumulative_panel <- function(v, ttl, kk) {
  par(mar=c(5,5,3,1))
  plot(seq_len(nrow(v)),v$Cumulative_Percent,type="b",pch=19,cex=.65,
       ylim=c(0,100),xlab="Number of components",
       ylab="Cumulative variance (%)",main=ttl)
  abline(h=80,lty=2,col="red")
  abline(v=kk,lty=3)
}
