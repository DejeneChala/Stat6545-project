summary_pca <- function(f) {
  eig <- f$sdev^2
  data.frame(Component=paste0("PC",seq_along(eig)),Eigenvalue=eig,
   Variance_Percent=100*eig/sum(eig),
   Cumulative_Percent=100*cumsum(eig)/sum(eig))
}
